      "customQuery" : "SELECT\n    c.*,\n    cc.*,\n    cp.*,\n    dr.*,\n    ds.*,\n    df.*,\n    so.*,\n    dv.*\n \nFROM WYNN_RESORT_DWH_DEV.STG_DATA.STG_CUSTOMER c\n \nLEFT JOIN WYNN_RESORT_DWH_DEV.STG_DATA.STG_CUSTOMER_CONTACT cc\n    ON c.customer_id = cc.customer_id\n \nLEFT JOIN WYNN_RESORT_DWH_DEV.STG_DATA.STG_CUSTOMER_PREFERENCE cp\n    ON c.customer_id = cp.customer_id\n \nLEFT JOIN WYNN_RESORT_DWH_DEV.STG_DATA.STG_DINING_RESERVATION dr\n    ON c.customer_id = dr.customer_id\n \nLEFT JOIN WYNN_RESORT_DWH_DEV.STG_DATA.STG_DINING_SPENDING ds\n    ON dr.reservation_id = ds.reservation_id\n \nLEFT JOIN WYNN_RESORT_DWH_DEV.STG_DATA.STG_DINING_SPECIAL_OCCASION so\n    ON dr.reservation_id = so.reservation_id\n    AND c.customer_id = so.customer_id\n \nLEFT JOIN WYNN_RESORT_DWH_DEV.STG_DATA.STG_DINING_FEEDBACK df\n    ON c.customer_id = df.customer_id\n \nLEFT JOIN WYNN_RESORT_DWH_DEV.STG_DATA.STG_DINING_VENUE dv\n    ON dr.dining_venue_name = dv.venue_name;",
