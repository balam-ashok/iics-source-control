                  <serviceInput>
                     <parameter name="i_sessionId" source="field">output.sessionId</parameter>
                     <parameter name="Body" source="formula">
                        <expression language="XQuery">let $folderId := normalize-space($input.FolderId)
let $guid := normalize-space($input.Guid)
let $name := normalize-space($input.Name)
let $version := normalize-space($input.Version)

return
concat(
'{',
'"folder":"', $folderId, '",',
'"frsID":"",',
'"guid":"', $guid, '",',
'"method":"create",',
'"resource":"dynamicPool",',
'"payload":{',
    '"guid":"', $guid, '",',
    '"_meta":{',
        '"version":', $version,
    '},',
    '"ownerRole":"",',
    '"icon":"icon:customBe",',
    '"label":{',
        '"eClass":"http://informatica.com/mdm/v2/Core#//LocalizedText",',
        '"en":"', $name, '"',
    '}',
'},',
'"undeployDQRules":false',
'}'
)</expression>
                     </parameter>
                  </serviceInput>
                  <link id="x2041b297-2b24-4c54-93c5-94e609a0c782"
                        targetId="a16CEW8o0KO8edRkPIyHzVco-Service587b37a9-6945-41e7-a97c-89c4b5110959"/>
               </service>
               <service id="a16CEW8o0KO8edRkPIyHzVco-Service587b37a9-6945-41e7-a97c-89c4b5110959">
                  <title>Connection 3</title>
                  <serviceName>ac-migration:createFields</serviceName>
                  <serviceGUID>ij87FVZxQghgk62PLw56Ww</serviceGUID>
                  <serviceInput>
                     <parameter name="ip_sessionId" source="field">output.sessionId</parameter>
                     <parameter name="Body" source="formula">
                        <expression language="XQuery">let $folderId := normalize-space($input.FolderId)
let $poolGuid := normalize-space($input.Guid)
let $fieldNames := $input.FieldName
let $dataTypes := $input.DataType

let $dynamicFields :=
    for $i in 1 to count($fieldNames)

    let $fieldName := normalize-space($fieldNames[$i])
    let $dataType := lower-case(normalize-space($dataTypes[$i]))

    let $fieldEclass :=
        if ($dataType = 'text')
        then 'http://informatica.com/mdm/v2/Core#//TextField'
        else if ($dataType = 'integer')
        then 'http://informatica.com/mdm/v2/Core#//IntegerField'
        else if ($dataType = 'decimal')
        then 'http://informatica.com/mdm/v2/Core#//DecimalField'
        else if ($dataType = 'double')
        then 'http://informatica.com/mdm/v2/Core#//DoubleField'
        else
        'http://informatica.com/mdm/v2/Core#//TextField'

    let $position := 400000 + ($i - 1)

    return
        concat(
            '{',
                '"dynamicFieldTemplateOptions":{',
                    '"eClass":"http://informatica.com/mdm/v2/Core#//DynamicFieldTemplateOptions",',
                    '"searchConfiguration":{',
                        '"eClass":"http://informatica.com/mdm/v2/Core#//BusinessEntitySearchConfiguration",',
                        '"searchField":[]',
                    '}',
                '},',

                '"dynamicPool":{',
                    '"$ref":"', $poolGuid, '"',
                '},',

                '"field":{',
                    '"eClass":"', $fieldEclass, '",',

                    '"label":{',
                        '"eClass":"http://informatica.com/mdm/v2/Core#//LocalizedText",',
                        '"en":"', $fieldName, '"',
                    '},',

                    if ($dataType = 'text')
                    then '"length":255,'
                    else '',

                    '"name":"', lower-case($fieldName), '",',
                    '"position":', $position,
                '},',

                '"guid":"', lower-case($fieldName), '_', $poolGuid, '",',

                '"_meta":{',
                    '"version":1',
                '}',
            '}'
        )

return
concat(
    '{',
        '"folder":"', $folderId, '",',
        '"guid":"datamodel",',
        '"method":"update",',
        '"resource":"tenantModel",',
        '"payload":{',
            '"guid":"datamodel",',
            '"dynamicFieldTemplate":[',
                string-join($dynamicFields, ','),
            ']',
        '},',
        '"undeployDQRules":false',
    '}'
)</expression>
                     </parameter>
                  </serviceInput>
