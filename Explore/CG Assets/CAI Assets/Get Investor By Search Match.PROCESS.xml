                           <assignment id="a103gltocwwq5izoh7HVfASg-Assignment396ff8db-dcc0-417c-99ef-0dd4586bcf5c">
                              <title>Assignment to , searchResponse</title>
                              <operation source="formula" to="temp.t_expectedResult">
                                 <expression language="XQuery">let $records := $output.entireResponse/searchResult/records

let $bestRank := min($records/_meta/rank)
let $bestScore :=
  max(
    $records[_meta/rank = $bestRank]/_meta/score
  )

let $survivors :=
  $records[
    _meta/rank = $bestRank
    and _meta/score = $bestScore
  ]

return
&lt;root&gt;
  &lt;searchResult&gt;
    { $survivors }
  &lt;/searchResult&gt;
&lt;/root&gt;</expression>
                              </operation>
                              <operation source="formula" to="output.searchResponse">
                                 <expression language="XQuery">for $rec in $temp.t_expectedResult/searchResult/records
return
&lt;searchMatchRes&gt;
    &lt;persons&gt;
        &lt;personFirstName&gt;
            { $rec/data/personFirstName/text() }
        &lt;/personFirstName&gt;

        &lt;personLastName&gt;
            { $rec/data/personLastName/text() }
        &lt;/personLastName&gt;

        &lt;suspendInd&gt;{ $rec/data/suspendIndicator/text() }&lt;/suspendInd&gt;

        &lt;!-- FIXED: Only first suspensionReason --&gt;
        &lt;suspensionReason&gt;
            &lt;name&gt;{ $rec/data/suspendReason[1]/Name/text() }&lt;/name&gt;
            &lt;code&gt;{ $rec/data/suspendReason[1]/Code/text() }&lt;/code&gt;
            &lt;effectiveReferenceId&gt;{ $rec/data/suspendReason[1]/Code/text() }&lt;/effectiveReferenceId&gt;
        &lt;/suspensionReason&gt;

        &lt;effectiveReferenceId&gt;
            { $rec/_meta/businessId/text() }
        &lt;/effectiveReferenceId&gt;

        &lt;systemLastUpdatedBy&gt;
            { fn:upper-case($rec/data/rootSourceSystem/text()) }
        &lt;/systemLastUpdatedBy&gt;

        &lt;partyId&gt;
            { $rec/_meta/businessId/text() }
        &lt;/partyId&gt;

        &lt;!-- FIXED: Only first partyTaxResidenceCode --&gt;
        &lt;partyTaxResidenceCode&gt;
            &lt;code&gt;
                { $rec/data/partyTaxResidenceCode[1]/Code/text() }
            &lt;/code&gt;
            &lt;name&gt;
                { $rec/data/partyTaxResidenceCode[1]/Name/text() }
            &lt;/name&gt;
            &lt;taxResidenceCd&gt;
                { $rec/data/partyTaxResidenceCode[1]/Code/text() }
            &lt;/taxResidenceCd&gt;
            &lt;effectiveReferenceId&gt;
                { $rec/data/partyTaxResidenceCode[1]/Code/text() }
            &lt;/effectiveReferenceId&gt;
        &lt;/partyTaxResidenceCode&gt;

    &lt;/persons&gt;

    &lt;rulesetName&gt;
        { $temp.t_matchModelName }
    &lt;/rulesetName&gt;

    &lt;ruleNumber&gt;
        { $rec/_meta/rank/text() }
    &lt;/ruleNumber&gt;

    &lt;matchScore&gt;
        { $rec/_meta/score/text() }
    &lt;/matchScore&gt;
&lt;/searchMatchRes&gt;</expression>
                              </operation>
