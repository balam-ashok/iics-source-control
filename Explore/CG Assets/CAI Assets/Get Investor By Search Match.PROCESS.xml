                        <operation source="formula" to="temp.t_matchModelId">
                           <expression language="XQuery">let $PARTY_MATCH_RULE_SEARCHMATCH_1 :='b6512f0e-6f82-41eb-bcb0-37ccd6341887'
let $PARTY_MATCH_RULE_SEARCHMATCH_2 :='d2e6977a-ca54-4129-ace6-0fe4808d61a5'
let $PARTY_MATCH_RULE_SEARCHMATCH_3 :='2641bb39-b771-4a14-a088-6f3e3fa5cefc'
let $PARTY_MATCH_RULE_SEARCHMATCH_4 :='7d2ed73b-9512-4b58-89b4-8ba502f350c8'
let $PARTY_MATCH_RULE_SEARCHMATCH_5 :='8dd67ddd-11cd-40d4-9e1d-695b25818bb8'

(: Scalars :)
let $hasDob := normalize-space(string($input.personDob)) != ''
let $hasTax := normalize-space(string($input.partyTaxIdLast4)) != ''

(: Address :)
let $hasAddress :=
  exists($input.addresses/*[normalize-space(string(.)) != ''])

(: CAI array items :)
let $cms := $input.contactMechanisms

(: Email: code = 301 :)
let $hasEmail :=
  exists(
    $cms[
      normalize-space(string(contactMechanismValue)) != '' and
      normalize-space(string(contactMechanismType/code)) = '301'
    ]
  )

(: Phone: code = 303 or 306 :)
let $hasPhone :=
  exists(
    $cms[
      normalize-space(string(contactMechanismValue)) != '' and
      (
        normalize-space(string(contactMechanismType/code)) = '303' or
        normalize-space(string(contactMechanismType/code)) = '306'
      )
    ]
  )

(: Score :)
let $score :=
  (if ($hasDob) then 1 else 0) +
  (if ($hasTax) then 1 else 0) +
  (if ($hasAddress) then 1 else 0) +
  (if ($hasEmail) then 1 else 0) +
  (if ($hasPhone) then 1 else 0)

let $rule :=
  if ($score &gt;= 5) then 'PARTY_MATCH_RULE_SEARCHMATCH_5'
  else if ($score = 4) then 'PARTY_MATCH_RULE_SEARCHMATCH_1'
  else if ($score = 3) then 'PARTY_MATCH_RULE_SEARCHMATCH_2'
  else if ($score = 2) then 'PARTY_MATCH_RULE_SEARCHMATCH_3'
  else 'PARTY_MATCH_RULE_SEARCHMATCH_4'


let $rule :=
  if ($score &gt;= 5) then $PARTY_MATCH_RULE_SEARCHMATCH_5
  else if ($score = 4) then $PARTY_MATCH_RULE_SEARCHMATCH_1
  else if ($score = 3) then $PARTY_MATCH_RULE_SEARCHMATCH_2
  else if ($score = 2) then $PARTY_MATCH_RULE_SEARCHMATCH_3
  else $PARTY_MATCH_RULE_SEARCHMATCH_4

return $rule</expression>
                        </operation>
                        <operation source="formula" to="temp.t_matchModelName">
                           <expression language="XQuery">(: Scalars :)
let $hasDob := normalize-space(string($input.personDob)) != ''
let $hasTax := normalize-space(string($input.partyTaxIdLast4)) != ''

(: Address :)
let $hasAddress :=
