                     <assignment id="a103gltocwwq5izoh7HVfASg-Assignment1e43b653-4388-4278-9d34-ac0cb8fcc619">
                        <title>Assignment to payload</title>
                        <operation source="formula" to="temp.t_payload">
                           <expression language="XQuery">(
  (: ------------------- Normalize scalar fields safely ------------------- :)
  let $personName :=
    string-join(
      (
        normalize-space($input.personFirstName)[. != ''],
        normalize-space($input.personLastName)[. != '']
      ),
      ' '
    )

  let $person_standardized := normalize-space(string($personName))
  let $dob                 := normalize-space(string($input.personDob))
  let $tax_last4           := normalize-space(string($input.partyTaxIdLast4))
  let $taxIdTypeName       := normalize-space(string($input.taxIdType/name))
  let $taxIdTypeCode       := normalize-space(string($input.taxIdType/code))

  (: ------------------- Address fields ------------------- :)
  let $addr1                   := normalize-space(string($input.addresses/streetLine1))
  let $addr2                   := normalize-space(string($input.addresses/streetLine2))
  let $postal                  := normalize-space(string($input.addresses/postalCode))
  let $city                    := normalize-space(string($input.addresses/city))
  let $country_name            := normalize-space(string($input.addresses/country/name))
  let $country_code            := normalize-space(string($input.addresses/country/code))
  let $countrySubdivision_name := normalize-space(string($input.addresses/countrySubDivision/name))
  let $countrySubdivision_code := normalize-space(string($input.addresses/countrySubDivision/code))
  let $state                   := normalize-space(string($input.addresses/state))

  (: ------------------- Contact mechanisms ------------------- :)
  let $cms := $input.contactMechanisms

  (: ------------------- Code → Name mapping ------------------- :)
  let $code_to_name :=
    function($c as xs:string) as xs:string {
      let $cc := normalize-space($c)
      return
        if ($cc = "301") then "Email Address"
        else if ($cc = "303") then "Phone Number"
        else if ($cc = "306") then "Mobile Phone Number"
        else ""
    }

  (: ------------------- Build contact_mechanisms array ------------------- :)
  let $contact_mechanisms :=
    if (exists($cms)) then
      array {
        for $cm in $cms
        let $code  := normalize-space(string($cm/contactMechanismType/code))
        let $value := normalize-space(string($cm/contactMechanismValue))
        return
          map {
            "contactMechanismType": map {
              "Name": $code_to_name($code),
              "Code": if ($code != "") then $code else ""
            },
            "contactMechanismValue": if ($value != "") then $value else ""
          }
      }
    else
      array {
        map {
          "contactMechanismType": map { "Name": "", "Code": "" },
          "contactMechanismValue": ""
        }
      }

  (: ------------------- Build addresses array ------------------- :)
  let $addresses :=
    array {
      map {
        "streetLine1": if ($addr1 != "") then $addr1 else "",
        "streetLine2": if ($addr2 != "") then $addr2 else "",
		  "formattedAddressLine1":"",
		  "formattedAddressLine2":"",        
        "postalCode":            if ($postal != "") then $postal else "",
        "country": map {
          "Name": if ($country_name != "") then $country_name else "",
          "Code": if ($country_code != "") then $country_code else ""
        },
        "city": if ($city != "") then $city else "",
        "countrySubdivision": map {
          "Name": if ($countrySubdivision_name != "") then $countrySubdivision_name else "",
          "Code": if ($countrySubdivision_code != "") then $countrySubdivision_code else ""
        },
        "state2":   if ($state != "") then $state else "",
        "country2": ""  (: Added as requested :)
      }
    }

  (: ------------------- Final payload ------------------- :)
  let $payload :=
    map {
      "searchControls": map {
        "maxRecordsToReturn": 100,
        "searchLevel": "Typical",
        "fileRecordLimit": 10000
      },
      "data": map {
        "searchRecord": map {
          "partyType": map { "Name": "Person", "Code": 2102 },

          "personStandardizedName": if ($person_standardized != "") then $person_standardized else "",
          "personBirthDate":        if ($dob != "") then $dob else "",

          "taxIdentificationType": map {
            "Name": if ($taxIdTypeName != "") then $taxIdTypeName else "",
            "Code": if ($taxIdTypeCode != "") then $taxIdTypeCode else ""
          },

          "partyTaxIdLast4": if ($tax_last4 != "") then $tax_last4 else "",
          		  "personFirstName": "",
          "personMiddleName": "",
          "personMiddleInitial": "",
          "personLastName": "",
          "rootSourceSystem": "",
          "suspendIndicator":"",
          "suspendReason": map {"Name":"","Code":""},
          "partyTaxResidenceCode": map {"Name":"","Code":""},
          "addresses":       $addresses,
          "contact_mechanisms": $contact_mechanisms
        }
      }
    }

  return serialize($payload, map { "method": "json", "indent": false() })
)</expression>
                        </operation>
